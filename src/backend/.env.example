# ===================================================
# Placement Management System — Backend Environment
# ===================================================

# Server
PORT=5000
NODE_ENV=development

# Firebase Admin SDK
# Download your service account key from Firebase Console:
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# University Email Domain
UNIVERSITY_EMAIL_DOMAIN=uohyd.ac.in

# Resend email provider (get API key at resend.com)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=PMS <placements@uohyd.ac.in>

# Firebase Storage bucket (same project as Firestore)
# Firebase Console → Storage → Get Started → copy the bucket name (project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# OTP settings (optional overrides)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
